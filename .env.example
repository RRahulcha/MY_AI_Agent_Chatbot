# ==============================================================
# SETTribe AMS - Environment Configuration Template
# ==============================================================

# Web Port (Optional, default 8080 for Docker, e.g. http://localhost:8080)
PORT=8080

# Internal AI Microservice URL (Default for Docker: http://ai_service:5001, Local: http://127.0.0.1:5001)
AI_SERVICE_URL=http://ai_service:5001

# Option 1: Full Database URL Format
# DATABASE_URL=mysql://username:password@hostname:3306/database_name

# Option 2: Individual Database Connection Variables
DB_HOST=localhost
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=your_db_name
DB_PORT=3306

# Cloudflare R2 / AWS S3 Configuration (Optional)
# R2_ACCESS_KEY_ID=your_access_key
# R2_SECRET_ACCESS_KEY=your_secret_key
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# R2_BUCKET_NAME=dev-ams-settribe
# R2_PUBLIC_URL=https://your-public-domain.r2.dev/

# ==============================================================
# AI Assistant Chatbot Microservice (FastAPI + LangGraph)
# ==============================================================
AI_CHATBOT_ENABLED=false
AI_CHATBOT_ALLOWED_ROLES=admin,hr,employee,intern
AI_CHAT_SERVICE_URL=http://127.0.0.1:8000
AI_INTERNAL_SECRET=change_me_to_a_random_64_character_hex_secret

# Write Operation Sub-Flags (Default: false)
AI_WRITE_LEAVE_ENABLED=false
AI_WRITE_TASK_ENABLED=false

# LLM & Vector Store Providers
LLM_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=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
GEMINI_API_KEY=
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

